{
  "name": "@sarant/cloudflare-email-component",
  "description": "A Convex component to send, receive and track email through your own Cloudflare account.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saranatour1/cloudflare-email-component.git"
  },
  "homepage": "https://github.com/saranatour1/cloudflare-email-component#readme",
  "bugs": {
    "url": "https://github.com/saranatour1/cloudflare-email-component/issues"
  },
  "version": "0.2.2",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "convex",
    "component",
    "convex-component",
    "cloudflare",
    "email",
    "email-sending",
    "email-routing",
    "transactional-email"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'pnpm run dev:build'",
    "dev:example": "vp dev example",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'pnpm run build:codegen' --initial",
    "predev": "convex init && pnpm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "build:codegen": "convex codegen --component-dir ./src/component && vp fmt src/component/_generated && pnpm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && pnpm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example/convex && tsc -p example",
    "lint": "vp lint .",
    "test": "vp test run --typecheck",
    "test:watch": "vp test --typecheck --clearScreen false",
    "test:debug": "vp test --inspect-brk --no-file-parallelism",
    "test:coverage": "vp test run --coverage --coverage.reporter=text",
    "prepare": "pnpm run build",
    "preversion": "pnpm install --frozen-lockfile && pnpm run build:clean && pnpm run test && pnpm run lint && pnpm run typecheck",
    "alpha": "pnpm version prerelease --preid alpha && git push --follow-tags",
    "release": "pnpm version patch && git push --follow-tags",
    "release:minor": "pnpm version minor && git push --follow-tags",
    "version": "node scripts/changelog.mjs && vp fmt CHANGELOG.md && git add CHANGELOG.md"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./cloudflare": {
      "types": "./dist/client/cloudflare.d.ts",
      "default": "./dist/client/cloudflare.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "convex": "^1.49.0"
  },
  "devDependencies": {
    "@convex-dev/auth": "^2.0.0-beta.0",
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "chokidar-cli": "3.0.0",
    "convex": "^1.49.0",
    "convex-test": "0.0.67",
    "globals": "^17.9.0",
    "pkg-pr-new": "^0.0.86",
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js",
  "packageManager": "pnpm@12.6.0"
}
